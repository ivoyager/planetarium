; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="I, Voyager - Planetarium"
config/version="0.2.1.dev"
run/main_scene="uid://mcxrmcs1puig"
config/project_settings_override="user://override.cfg"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="res://web/jupiter-144.png"
icon="res://jupiter-icon-128.png"
main_scene="res://addons/ivoyager_core/tree_nodes/universe.tscn"
name="I, Voyager - Planetarium"

[autoload]

IVUnits="*uid://ceqj2b3v48ds0"
IVQConvert="*uid://c8hrxn2mc6635"
IVQFormat="*uid://b6qll4nfpigux"
IVTableData="*uid://kimqfyyqxcfo"
IVAstronomy="*uid://g2r1xgmex1as"
IVGlobal="*uid://dlo5sdgqt41do"
IVCoreSettings="*uid://q3dwrk3lnx0f"
IVCoreInitializer="*uid://chh7oxyc16wm0"
IVSettingsManager="*uid://b8tkwtacbefl6"
IVStateManager="*uid://dfigrpveqtlg2"
IVAssistantServer="*uid://cf38hsxudekl"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/directory_rules={
"res://addons": 1
}
gdscript/warnings/unused_signal=false
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=true
gdscript/warnings/return_value_discarded=false
gdscript/warnings/static_called_on_instance=0

[editor_plugins]

enabled=PackedStringArray("res://addons/ivoyager_assistant/plugin.cfg", "res://addons/ivoyager_core/plugin.cfg", "res://addons/ivoyager_tables/plugin.cfg", "res://addons/ivoyager_units/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="uid://c1ce75roeyk17"
theme/custom_font="uid://btl3ian81yhn4"

[importer_defaults]

texture={
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 2,
"compress/normal_map": 0,
"detect_3d": false,
"flags/anisotropic": false,
"flags/filter": true,
"flags/mipmaps": true,
"flags/repeat": true,
"flags/srgb": 1,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

